DATABASE_URL=sakuravel:password@tcp(localhost:3306)/sakuravel?parseTime=true&charset=utf8mb4
PORT=8080

#OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://host.docker.internal:4318/v1/traces
#OTEL_SERVICE_NAME=sakuravel-api
#DEPLOY_ENV=production
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_SERVICE_NAME=
API_PORT=8080
API_URL=
ALLOWED_ORIGIN=

# コンテナレジストリのホスト名（例: intern28-b.sakuracr.jp）
CR_URL=

# ---- compose.reg.yml の migrate ワンショットrunner 用 ----
# 外部DB(さくらのクラウド DBアプライアンス)への接続情報。
# デプロイ先では infra/terraform が .env を自動生成するため設定不要。
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# ---- compose.reg.direct.yml（DBもコンテナで動かす構成）用 ----
# 必ず推測困難な値に変更すること
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ---- 性能比較（イメージの焼き分け）----
# 起動する backend イメージのタグ。scripts/switch-variant.sh で切り替える。
#   baseline  : N+1 等を含む改善前のアプリコード
#   optimized : 改善後のアプリコード
BACKEND_TAG=optimized
FRONTEND_TAG=latest

DATABASE_URL=sakuravel:password@tcp(localhost:3306)/sakuravel?parseTime=true&charset=utf8mb4
PORT=8080

#OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://host.docker.internal:4318/v1/traces
#OTEL_SERVICE_NAME=sakuravel-api
#DEPLOY_ENV=production
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_SERVICE_NAME=
API_PORT=8080
API_URL=
ALLOWED_ORIGIN=

# DB 認証情報（compose の db サービスが参照。必ず推測困難な値に変更すること）
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ---- 性能比較（イメージの焼き分け）----
# コンテナレジストリのホスト名（compose.reg.direct.yml が参照）
REGISTRY_URL=
# 起動する backend イメージのタグ。scripts/switch-variant.sh で切り替える。
#   baseline  : N+1 等を含む改善前のアプリコード
#   optimized : 改善後のアプリコード
BACKEND_TAG=optimized
FRONTEND_TAG=latest

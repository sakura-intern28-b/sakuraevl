#cloud-config
hostname: ${hostname}
manage_etc_hosts: true

ssh_pwauth: false
ssh_authorized_keys:
  - ${ssh_public_key}

package_update: true
package_upgrade: true

# setfacl (nginx ログを collector に読ませる ACL 設定) に必要。
# 最小イメージには入っていないことがあるため明示する。
packages:
  - acl

write_files:
  - path: /usr/local/bin/configure-private-nic.sh
    permissions: '0755'
    content: |
      #!/bin/sh
      set -eu

      public_if="$(ip route show default | awk '/default/ {print $5; exit}')"
      private_if="$(ls /sys/class/net | grep -Ev '^(lo|docker0)$' | grep -vx "$public_if" | head -n1)"

      if [ -z "$private_if" ]; then
        echo "private interface not found" >&2
        exit 1
      fi

      cat >/etc/netplan/60-private-nic.yaml <<EOF
      network:
        version: 2
        ethernets:
          $${private_if}:
            dhcp4: false
            addresses:
              - ${private_ip_cidr}
      EOF

      # netplan は world-readable な設定ファイルを警告する
      chmod 600 /etc/netplan/60-private-nic.yaml

      netplan apply

      # netplan apply は systemd-networkd / systemd-resolved を再起動するため、
      # 直後の数秒間は名前解決ができない。runcmd はこのスクリプトの直後に
      # curl や wget で外部からダウンロードするので、待たずに進むと
      # "Could not resolve host" で Docker のインストールごと失敗する
      # (cloud-init の runcmd は途中で失敗しても後続を実行し続けるため、
      #  最終的に docker コマンドが無いまま起動完了してしまう)。
      i=0
      while [ "$i" -lt 60 ]; do
        if getent hosts archive.ubuntu.com >/dev/null 2>&1; then
          exit 0
        fi
        i=$((i + 1))
        sleep 2
      done

      echo "DNS did not recover within 120s after netplan apply" >&2
      exit 1

  # sacloud-otel-collector の設定。deb パッケージが置く既定の
  # config.yaml と衝突しないよう一旦ステージングし、インストール後に
  # runcmd で /etc/sacloud-otel-collector/config.yaml へ配置する。
  - path: /opt/sacloud-otel-collector-config.yaml
    permissions: '0600'
    content: |
      receivers:
        # VMホスト自体のメトリクス
        hostmetrics:
          collection_interval: 10s
          scrapers:
            cpu:
              metrics:
                system.cpu.utilization:
                  enabled: true
            memory:
              metrics:
                system.memory.utilization:
                  enabled: true
            disk:
            filesystem:
              metrics:
                system.filesystem.utilization:
                  enabled: true
            network:
            paging:
              metrics:
                system.paging.utilization:
                  enabled: true
        # nginx (proxy コンテナ) がホストマウントへ書くアクセスログ。
        # 中身は app/backend/nginx/nginx.conf の log_format json_logs による
        # JSON文字列で、パースはモニタリングスイート側に任せてそのまま送る。
        filelog:
          start_at: end
          exclude: []
          include:
            - ${app_remote_dir}/nginx/logs/access.log
        # api コンテナからのトレース (compose の
        # OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://host.docker.internal:4318/v1/traces)。
        # 0.0.0.0 で listen するが、パケットフィルタの Deny All により
        # インターネットからは到達できない (docker ブリッジからのみ)。
        otlp:
          protocols:
            http:
              endpoint: 0.0.0.0:4318

      processors:
        # モニタリングスイートのUIはリソース属性のうち既知のもの
        # (service_name, deployment_environment_name 等) しか表示しないため、
        # 新旧比較用の service.version をスパン属性へコピーして
        # スパン属性欄で見られるようにする
        transform/span-version:
          trace_statements:
            - context: span
              statements:
                - set(attributes["service.version"], resource.attributes["service.version"])
        resourcedetection:
          detectors: [system]
          system:
            hostname_sources: [os]

      exporters:
        # journalctl -u sacloud-otel-collector で送信状況を確認できるようにする
        debug:
        sacloud:
          metrics:
            endpoint: "${monitoring_metrics_endpoint}"
            token: "${monitoring_metrics_token}"
          traces:
            endpoint: "${monitoring_traces_endpoint}"
            token: "${monitoring_traces_token}"
          logs:
            endpoint: "${monitoring_logs_endpoint}"
            token: "${monitoring_logs_token}"

      service:
        pipelines:
          metrics:
            receivers: [hostmetrics]
            processors: [resourcedetection]
            exporters: [sacloud, debug]
          logs:
            receivers: [filelog]
            processors: [resourcedetection]
            exporters: [sacloud, debug]
          traces:
            receivers: [otlp]
            processors: [transform/span-version]
            exporters: [sacloud]

runcmd:
  - /usr/local/bin/configure-private-nic.sh
  # Docker EngineとCompose V2インストール
  - curl -fsSL --retry 5 --retry-delay 3 --retry-all-errors https://get.docker.com | sh
  - systemctl enable --now docker
  - usermod -a -G docker ubuntu
  # sacloud-otel-collector: モニタリングスイートへのトレース/ログ転送
  - wget -q --tries=5 --waitretry=3 -O /tmp/sacloud-otel-collector.deb https://github.com/sacloud/sacloud-otel-collector/releases/download/v${otel_collector_version}/sacloud-otel-collector_${otel_collector_version}_linux_amd64.deb
  - dpkg -i /tmp/sacloud-otel-collector.deb
  # Collector は専用ユーザー sacloud-otelcol で動くため、グループに読み権限を与える
  - install -m 640 -o root -g sacloud-otelcol /opt/sacloud-otel-collector-config.yaml /etc/sacloud-otel-collector/config.yaml
  # Collector は専用ユーザー sacloud-otelcol で動くため、root 所有で書かれる
  # nginx のログを ACL で読めるようにする。
  # terraform 再デプロイ (deploy.tf) が nginx/ を rm -rf で作り直すため、
  # nginx/logs に直接付けた ACL は消える。消されない ${app_remote_dir} 自体に
  # default ACL を付け、再生成されるサブディレクトリ・ファイルに継承させる。
  - mkdir -p ${app_remote_dir}
  - setfacl -R -m u:sacloud-otelcol:rX ${app_remote_dir}
  - setfacl -R -d -m u:sacloud-otelcol:rX ${app_remote_dir}
  - systemctl enable sacloud-otel-collector
  - systemctl restart sacloud-otel-collector

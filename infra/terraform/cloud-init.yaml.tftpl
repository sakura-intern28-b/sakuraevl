#cloud-config
hostname: ${hostname}
manage_etc_hosts: true
password: ${password}
chpasswd:
  expire: false
%{ if ssh_public_key != "" ~}
ssh_pwauth: false
ssh_authorized_keys:
  - ${ssh_public_key}
%{ else ~}
ssh_pwauth: true
%{ endif ~}

package_update: true
package_upgrade: true

write_files:
  - path: /usr/local/bin/configure-private-nic.sh
    permissions: '0755'
    content: |
      #!/bin/sh
      set -eu

      public_if="$(ip route show default | awk '/default/ {print $5; exit}')"
      private_if="$(ls /sys/class/net | grep -Ev '^(lo|docker0)$' | grep -vx "$public_if" | head -n1)"

      if [ -z "$private_if" ]; then
        echo "private interface not found" >&2
        exit 1
      fi

      cat >/etc/netplan/60-private-nic.yaml <<EOF
      network:
        version: 2
        ethernets:
          $${private_if}:
            dhcp4: false
            addresses:
              - ${private_ip_cidr}
      EOF

      netplan apply
%{ if otel_collector_enabled ~}

  # sacloud-otel-collector の設定。deb パッケージが置く既定の
  # config.yaml と衝突しないよう一旦ステージングし、インストール後に
  # runcmd で /etc/sacloud-otel-collector/config.yaml へ配置する。
  - path: /opt/sacloud-otel-collector-config.yaml
    permissions: '0600'
    content: |
      receivers:
        # api コンテナからのトレース (compose の
        # OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://host.docker.internal:4318/v1/traces)。
        # 0.0.0.0 で listen するが、パケットフィルタの Deny All により
        # インターネットからは到達できない (docker ブリッジからのみ)。
        otlp:
          protocols:
            http:
              endpoint: 0.0.0.0:4318
%{ if monitoring_logs_token != "" ~}
        # nginx (proxy コンテナ) がホストマウントへ書く JSON アクセスログ。
        # フォーマットは app/backend/nginx/nginx.conf の log_format json_logs。
        filelog:
          start_at: end
          include:
            - ${app_remote_dir}/nginx/logs/access.log
          operators:
            - type: json_parser
%{ endif ~}

      exporters:
        sacloud:
%{ if monitoring_traces_token != "" ~}
          traces:
            endpoint: "${monitoring_traces_endpoint}"
            token: "${monitoring_traces_token}"
%{ endif ~}
%{ if monitoring_logs_token != "" ~}
          logs:
            endpoint: "${monitoring_logs_endpoint}"
            token: "${monitoring_logs_token}"
%{ endif ~}

      service:
        pipelines:
%{ if monitoring_traces_token != "" ~}
          traces:
            receivers: [otlp]
            exporters: [sacloud]
%{ endif ~}
%{ if monitoring_logs_token != "" ~}
          logs:
            receivers: [filelog]
            exporters: [sacloud]
%{ endif ~}
%{ endif ~}

runcmd:
  - /usr/local/bin/configure-private-nic.sh
  # Docker EngineとCompose V2インストール
  - curl -fsSL https://get.docker.com | sh
  - systemctl enable --now docker
  - usermod -a -G docker ubuntu
%{ if otel_collector_enabled ~}
  # sacloud-otel-collector: モニタリングスイートへのトレース/ログ転送
  - wget -qO /tmp/sacloud-otel-collector.deb https://github.com/sacloud/sacloud-otel-collector/releases/download/v${otel_collector_version}/sacloud-otel-collector_${otel_collector_version}_linux_amd64.deb
  - dpkg -i /tmp/sacloud-otel-collector.deb
  - install -m 600 -o root -g root /opt/sacloud-otel-collector-config.yaml /etc/sacloud-otel-collector/config.yaml
  - systemctl enable sacloud-otel-collector
  - systemctl restart sacloud-otel-collector
%{ endif ~}

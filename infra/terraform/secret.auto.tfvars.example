# 最初にこのファイルをコピーして編集します
# cp secret.auto.tfvars.example secret.auto.tfvars

# さくらのクラウド API トークン
sakura_access_token = "YOUR_SAKURA_ACCESS_TOKEN"

# さくらのクラウド API トークンシークレット
sakura_access_token_secret = "YOUR_SAKURA_ACCESS_TOKEN_SECRET"

# データベースのパスワード(データベース作成とデータベース接続時に使用)
# 1PasswordのDBパスワードからコピーします
db_password = "YOUR_DB_PASSWORD"

# 取得対象のコンテナレジストリを設定する
cr_url = "YOUR_CONTAINER_REGISTRY_URL"
cr_username = "YOUR_CONTAINER_REGISTRY_USERNAME"
cr_password = "YOUR_CONTAINER_REGISTRY_PASSWORD"
# SSH公開鍵認証のパス
# パスワード認証よりも安全にログインするために使用します
server_ssh_public_key_path = "~/.ssh/sakuravel_ed25519.pub"

# 公開ドメイン (ポート番号やスキームは含めない)
# 空文字 or 未設定にすると、サーバーの公開IPアドレス + app_http_port を使った
# HTTP 構成になる (IPアドレスには Let's Encrypt の証明書を発行できないため)
app_domain = ""
# サービスの公開ポート (proxy がホスト側で公開するポート)
app_https_port = 4430
app_http_port  = 8080
# Let's Encrypt の通知先。空なら admin@<app_domain> が使われる
certbot_email = ""

# モニタリングスイート連携 (sacloud-otel-collector)
# コンソールの各送信先で発行される ID とトークンを設定すると、
# cloud-init がVM作成時に Collector を自動セットアップします。
# 未設定 (空) の場合は何もインストールされません。
# 注意: あとから設定した場合はVMの再作成が必要です。
monitoring_logs_endpoint   = "YOUR_LOGS_ENDPOINT_ID"
monitoring_logs_token      = "log-XXXXXXXX"
monitoring_metrics_endpoint = "YOUR_METRICS_ENDPOINT_ID"
monitoring_metrics_token    = "met-XXXXXXXX"
monitoring_traces_endpoint = "YOUR_TRACES_ENDPOINT_ID"
monitoring_traces_token    = "trc-XXXXXXXX"
